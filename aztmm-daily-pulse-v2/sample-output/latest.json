    "content": "<!-- wp:html -->\n<div class=\"dpv1\" data-date=\"2026-05-14\">\n<style>\n.dpv1{font-family:-apple-system,BlinkMacSystemFont,\"Segoe UI\",Roboto,Helvetica,Arial,sans-serif;color:#e2e8f0;background:#0b1220;padding:0;margin:0 0 2rem;border-radius:14px;overflow:hidden;line-height:1.6}\n.dpv1 .dp-hero{background:linear-gradient(135deg,#0b1220 0%,#0f172a 45%,#1e293b 100%);padding:2rem 1.75rem 1.75rem;border-bottom:1px solid rgba(56,189,248,0.18)}\n.dpv1 .dp-meta{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;font-size:.82rem;color:#94a3b8;letter-spacing:.04em;text-transform:uppercase}\n.dpv1 .dp-date{color:#38bdf8;font-weight:600}\n.dpv1 .dp-sep{color:#475569}\n.dpv1 .dp-closing-bell{color:#cbd5e1}\n.dpv1 .dp-tag{display:inline-block;padding:.28rem .72rem;border-radius:999px;font-weight:700;font-size:.74rem;letter-spacing:.06em;background:linear-gradient(90deg,#10b981 0%,#38bdf8 100%);color:#0b1220;box-shadow:0 0 14px rgba(56,189,248,.25)}\n.dpv1 .dp-headline{font-size:1.7rem;line-height:1.25;margin:.9rem 0 .25rem;color:#f1f5f9;font-weight:700;letter-spacing:-.01em}\n.dpv1 .dp-sub{margin:.4rem 0 0;color:#94a3b8;font-size:.95rem}\n.dpv1 .dp-section{padding:1.5rem 1.75rem;border-bottom:1px solid rgba(71,85,105,.25)}\n.dpv1 .dp-section h3{color:#38bdf8;font-size:1.05rem;margin:0 0 .85rem;letter-spacing:.04em;text-transform:uppercase;font-weight:700;display:flex;align-items:center;gap:.5rem}\n.dpv1 .dp-section h3::before{content:\"\";display:inline-block;width:6px;height:18px;background:linear-gradient(180deg,#38bdf8,#10b981);border-radius:2px}\n.dpv1 .dp-narr p{margin:0 0 .9rem;color:#cbd5e1;font-size:1rem}\n.dpv1 .dp-narr p strong{color:#f1f5f9}\n.dpv1 .dp-narr p .pos{color:#10b981;font-weight:700}\n.dpv1 .dp-narr p .neg{color:#fb7185;font-weight:700}\n.dpv1 .dp-narr p .accent{color:#38bdf8;font-weight:700}\n.dpv1 .dp-narr p .warn{color:#fbbf24;font-weight:700}\n.dpv1 .dp-bullets{list-style:none;padding:0;margin:0;display:grid;grid-template-column