chlist li::before{content:counter(wl);position:absolute;left:1rem;top:50%;transform:translateY(-50%);width:1.85rem;height:1.85rem;border-radius:50%;background:linear-gradient(135deg,#38bdf8,#10b981);color:#0b1220;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.9rem}\n.dpv1 .dp-watchlist li strong{color:#38bdf8}\n.dpv1 .dp-footer{padding:1.25rem 1.75rem;background:rgba(15,23,42,.6);border-top:1px solid rgba(71,85,105,.25)}\n.dpv1 .dp-caveat{margin:0 0 .65rem;font-size:.82rem;color:#94a3b8;font-style:italic;line-height:1.55}\n.dpv1 .dp-disclaimer{margin:0;color:#64748b;font-size:.78rem;line-height:1.55}\n.dpv1 .dp-toptrades td:nth-child(1){color:#64748b;width:36px;text-align:center;font-variant-numeric:tabular-nums}\n.dpv1 .dp-toptrades td:nth-child(4).val-pos{color:#10b981;font-weight:700}\n.dpv1 .dp-toptrades td:nth-child(4).val-neg{color:#fb7185;font-weight:700}\n.dpv1 .dp-toptrades td:nth-child(5){font-weight:700;color:#f1f5f9;font-variant-numeric:tabular-nums}\n.dpv1 .dp-aggflow td:nth-child(2){color:#38bdf8;font-weight:700;font-variant-numeric:tabular-nums}\n.dpv1 .dp-aggflow td:nth-child(3){color:#94a3b8;font-variant-numeric:tabular-nums}\n.dpv1 .dp-aggflow td:nth-child(4){color:#cbd5e1;font-size:.85rem}\n.dpv1 .dp-sector-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:.85rem}\n.dpv1 .dp-sec-block{background:rgba(15,23,42,.5);border:1px solid rgba(56,189,248,.12);border-left:3px solid #38bdf8;border-radius:8px;padding:.85rem 1rem}\n.dpv1 .dp-sec-block h4{margin:0 0 .55rem;color:#38bdf8;font-size:.78rem;letter-spacing:.05em;text-transform:uppercase;font-weight:700}\n.dpv1 .dp-sec-block ul{list-style:none;margin:0;padding:0}\n.dpv1 .dp-sec-block li{display:flex;justify-content:space-between;align-items:center;padding:.32rem 0;border-bottom:1px dashed rgba(71,85,105,.22);font-variant-numeric:tabular-nums;font-size:.9rem}\n.dpv1 .dp-sec-block li:last-child{border-bottom:none}\n.dpv1 .dp-sec-block li strong{color:#f1f5f9}\n.dpv1 .dp-sec-block li .val-pos{color:#10b981;font-weight:700}\n.dpv1 .dp-sec-block p.dp-empty{margin:.25rem 0 0;color:#64748b;font-size:.88rem;font-style:italic}\n.dpv1 .dp-notable{list-style:none;padding:0;margin:0;counter-reset:n}\n.dpv1 .dp-notable li{counter-increment:n;padding:.7rem 1rem .7rem 3rem;position:relative;background:rgba(15,23,42,.4);border:1px solid rgba(71,85,105,.2);border-left:3px solid #10b981;border-radius:6px;margin-bottom:.5rem;color:#e2e8f0;font-size:.93rem;line-height:1.55}\n.dpv1 .dp-notable li::before{content:counter(n);position:absolute;left:.85rem;top:50%;transform:translateY(-50%);width:1.55rem;height:1.55rem;border-radius:50%;background:linear-gradient(135deg,#10b981,#38bdf8);color:#0b1220;display:flex;align-items:center;justify-content:center;font-weight:800;font-size:.78rem}\n.dpv1 .dp-notable li .pos{color:#10b981;font-weight:700}\n.dpv1 .dp-notable li .neg{color:#fb7185;font-weight:700}\n.dpv1 .dp-notable li .warn{color:#fbbf24;font-weight:700}\n.dpv1 .dp-notable li .accent{color:#38bdf8;font-weight:700}\n.dpv1 .dp-themes{display:grid;grid-template-columns:1fr;gap:.65rem}\n.dpv1 .dp-themes p{margin:0;background:rgba(15,23,42,.45);border:1px solid rgba(56,189,248,.14);border-left:3px solid #38bdf8;border-radius:6px;padding:.7rem .95rem;font-size:.93rem;color:#cbd5e1;line-height:1.55}\n.dpv1 .dp-themes p strong:first-child{color:#38bdf8;display:inline-block;margin-right:.25rem}\n.dpv1 .dp-themes .pos{color:#10b981;font-weight:700}\n.dpv1 .dp-themes .neg{color:#fb7185;font-weight:700}\n.dpv1 .dp-themes .accent{color:#38bdf8;font-weight:700}\n.dpv1 .dp-themes .warn{color:#fbbf24;font-weight:700}\n.sparkline-section .sparkline{display:block;width:100%;height:auto;margin:0 0 .5rem}\n.sparkline-section .sparkline-caption{margin:0;color:#94a3b8;font-size:.85rem;font-style:italic}\n@media (max-width:600px){.dpv1 .dp-headline{font-size:1.3rem}.dpv1 .dp-section{padding:1.25rem 1rem}.dpv1 .dp-hero{padding:1.5rem 1rem 1.25rem}.dpv1 .dp-concentration{grid-template-columns:1fr}.dpv1 .dp-why{margin:1.25rem 1rem}.dpv1 .dp-footer{padding:1.1rem 1rem}.dpv1 table{font-size:.85rem}.dpv1 table th,.dpv1 table td{padding:.5rem .55rem}.dpv1 .dp-toptrades{font-size:.78rem}.dpv1 .dp-toptrades th,.dpv1 .dp-toptrades td{padding:.4rem .4rem}.dpv1 .dp-sector-grid{grid-template-columns:1fr}}\n</style>\n\n  <div class=\"dp-hero\">\n    <div class=\"dp-meta\">\n      <span class=\"dp-date\">2026-05-14</span>\n      <span class=\"dp-sep\">/</span>\n      <span class=\"dp-tag\">BULL</span>\n      <span class=\"dp-sep\">/</span>\n      <span class=\"dp-closing-bell\">End-of-session read</span>\n    </div>\n    <h2 class=\"dp-headline\">Risk-on tape: broad participation, conviction flow leans long.</h2>\n<p class=\"dp-sub\">A tape where the option book ran 2.4:1, Materials hogged the call book, and the dark-pool tape produced the day's most-watched surprise.</p>  </div>\n\n  <section class=\"dp-section dp-narr\">\n    <h3>What I noticed today</h3>\n    <p>The first thing that jumped out was the lopsidedness of the option book. <strong>Call premium printed <span class=\"pos\">$45.61B</span> against put premium of <span class=\"neg\">$19.12B</span></strong> &mdash; a 2.4:1 skew &mdash; and the P/C volume ratio held at <span class=\"accent\">0.57</span> all session. The EOD cumulative net call premium closed at <strong><span class=\"pos\">$310.8M</span></strong>, which is the tell I pay attention to. Tape participants were paying for upside through the bell. Whether that conviction holds tomorrow is a separate question, but the read on today was clean.</p>\n    <p>What stood out next was the sector tape. Materials (XLB) ran <strong>$13.7M in call premium against $353.9K in puts</strong> &mdash; a net of <span class=\"pos\">$13.4M</span> that led the heatmap. Technology (XLK) was the second-tier read at <span class=\"pos\">$8.9M</span> net, with a 2.2:1 call-to-put ratio. </p>\n    <p>The cracks were in financials and consumer staples. <strong>XLF inverted</strong> with $4.4M call against $11.2M put for a net of <span class=\"neg\">-$6.8M</span>, and XLP did the same at <span class=\"neg\">-$207.6K</span>. Defense was selective today, not broad &mdash; the tape didn't hedge everything, it hedged the cyclicals.</p>\n    <p>Single-name aggregate flow lined up as <strong>SPX</strong> ($11.6M), <strong>QQQ</strong> ($4.3M), <strong>MU</strong> ($3.3M) at the top of the notable-flow book. Where the index complex (SPX, SPXW, SPY, QQQ, IWM) shows up in this list is the part I tag and watch the next session &mdash; index-side flow doesn't move like single-name flow.</p>\n    <p>And then the dark pool tape: <strong>NVDA at <span class=\"warn\">$1.40B in mega-print activity, up 978% from prior session</span></strong> &mdash; the single biggest day-over-day surge today. SPY ran $3.41B with 23 mega-prints (each &ge;100K shares). The NVDA print is the one I want to see tomorrow: if it sustains, it's a theme; if it fades, today was a one-day institutional rebalance.</p>\n  </section>\n\n  <section class=\"dp-section\">\n    <h3>By the numbers</h3>\n    <ul class=\"dp-bullets\">\n      <li>Call premium <strong>$45.61B</strong></li>\n      <li>Put premium <strong>$19.12B</strong></li>\n      <li>Call/Put skew <strong>2.4:1</strong></li>\n      <li>P/C volume <strong>0.57</strong></li>\n<li>EOD net call <strong>$310.8M</strong></li>      <li>Scenario <strong>BULL</strong></li>\n    </ul>\n    <p class=\"dp-tide\">Cumulative end-of-day net call premium closed at <strong>$310.8M</strong>. Tape closed at session highs (steady accumulation).</p>\n  </section>\n\n  <section class=\"dp-section\">\n    <h3>Top 10 single-trade events</h3>\n    <p style=\"margin:.2rem 0 .9rem;color:#94a3b8;font-size:.92rem\">Today's largest single-trade notable flow events, ranked by total premium. Observational only &mdash; what stood out, not a to-do.</p>\n    <table class=\"dp-toptrades\">\n      <thead><tr><th>#</th><th>Ticker</th><th>Strike &middot; Expiry (DTE)</th><th>Type</th><th>Premium</th><th>Vol / OI (V/OI)</th><th>Spot</th></tr></thead>\n      <tbody>\n        <tr>\n          <td>1</td>\n          <td><strong>SPX</strong></td>\n          <td>$7095 \u00b7 2026-05-15 (1d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$8.3M</td>\n          <td>204 / 458 (0.4x)</td>\n          <td>$7500.72</td>\n        </tr>\n        <tr>\n          <td>2</td>\n          <td><strong>MU</strong></td>\n          <td>$795 \u00b7 2026-05-22 (8d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$2.9M</td>\n          <td>3,395 / 782 (4.3x)</td>\n          <td>$780.35</td>\n        </tr>\n        <tr>\n          <td>3</td>\n          <td><strong>SPX</strong></td>\n          <td>$6800 \u00b7 2026-10-16 (155d)</td>\n          <td class=\"val-neg\">Put</td>\n          <td>$1.8M</td>\n          <td>243 / 6,048 (0.0x)</td>\n          <td>$7501.24</td>\n        </tr>\n        <tr>\n          <td>4</td>\n          <td><strong>META</strong></td>\n          <td>$575 \u00b7 2026-12-18 (218d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$1.7M</td>\n          <td>193 / 306 (0.6x)</td>\n          <td>$618.56</td>\n        </tr>\n        <tr>\n          <td>5</td>\n          <td><strong>QQQ</strong></td>\n          <td>$765 \u00b7 2027-01-15 (246d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$1.5M</td>\n          <td>730 / 3,019 (0.2x)</td>\n          <td>$719.85</td>\n        </tr>\n        <tr>\n          <td>6</td>\n          <td><strong>RUT</strong></td>\n          <td>$2770 \u00b7 2026-05-15 (1d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$934.0K</td>\n          <td>101 / 230 (0.4x)</td>\n          <td>$2862.5</td>\n        </tr>\n        <tr>\n          <td>7</td>\n          <td><strong>SLV</strong></td>\n          <td>$80 \u00b7 2026-05-22 (8d)</td>\n          <td class=\"val-pos\">Call</td>\n          <td>$