{# ============================================================
   AZTMM Daily Pulse v3 — Email-Safe Post Body
   Ported from daily-pulse-v3-PROFORMA-2026-05-14-v2.html
   ------------------------------------------------------------
   Rules:
     * NO references to data vendor names (brand_check enforces)
     * "TODAY'S TELL" is DESCRIPTIVE only — no entry / target /
       stop / conviction-score. Conviction is the internal gate
       that decides whether a name surfaces (>=80), never shown.
     * All <style>/<script> blocks MUST be wrapped in
       <!-- wp:html -->...<!-- /wp:html --> for WP Gutenberg.
     * Email-safe: 600px max-width table, inline CSS,
       NO flex / NO grid, all tables for layout.
   ============================================================ #}
<div style="max-width:1300px;margin:0 auto;padding:32px 16px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;">

<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#f1f5f9;padding:32px 0;border-radius:8px;">
  <tr>
    <td align="center">
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border-radius:10px;overflow:hidden;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Helvetica,Arial,sans-serif;border:1px solid #e2e8f0;">

        {# -------- View-on-web strip -------- #}
        <tr>
          <td style="background:#f8fafc;padding:10px 28px;border-bottom:1px solid #e2e8f0;text-align:right;">
            <a href="{{ appendix_url }}" style="color:#64748b;font-size:11px;text-decoration:none;letter-spacing:0.2px;">View on web &rarr;</a>
          </td>
        </tr>

        {# -------- Hero band -------- #}
        <tr>
          <td style="background:#0f172a;padding:32px 28px;border-bottom:3px solid {{ hero_underline_color }};">
            <p style="margin:0 0 12px 0;color:#94a3b8;font-size:10px;font-weight:600;letter-spacing:1.8px;text-transform:uppercase;line-height:1.4;">
              Live &middot; {{ post_date_display }} &middot; Closing Pulse
            </p>
            <h1 style="margin:0;color:#ffffff;font-size:22px;line-height:1.4;font-weight:600;letter-spacing:-0.2px;">
              {{ headline }}
            </h1>
          </td>
        </tr>

        {# -------- 3-strip regime card -------- #}
        <tr>
          <td style="padding:32px 28px 8px 28px;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
              <tr>
                <td style="padding:20px 6px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;text-align:center;width:33%;vertical-align:top;">
                  <p style="margin:0;color:#64748b;font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;">MPI</p>
                  <p style="margin:10px 0 4px 0;color:#0f172a;font-size:28px;font-weight:700;line-height:1;">{{ mpi_score }}</p>
                  <p style="margin:0;color:#10b981;font-size:11px;font-weight:600;letter-spacing:0.3px;">&#9650; {{ mpi_label }}</p>
                </td>
                <td style="width:10px;"></td>
                <td style="padding:20px 6px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;text-align:center;width:33%;vertical-align:top;">
                  <p style="margin:0;color:#64748b;font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;">Regime</p>
                  <p style="margin:10px 0 4px 0;color:#0f172a;font-size:15px;font-weight:600;line-height:1.3;">{{ regime_short }}</p>
                  <p style="margin:0;color:#10b981;font-size:11px;font-weight:600;letter-spacing:0.3px;">{{ regime_confidence_label }}</p>
                </td>
                <td style="width:10px;"></td>
                <td style="padding:20px 6px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;text-align:center;width:33%;vertical-align:top;">
                  <p style="margin:0;color:#64748b;font-size:10px;font-weight:600;letter-spacing:1.2px;text-transform:uppercase;">{{ key_metric_label }}</p>
                  <p style="margin:10px 0 4px 0;color:#0f172a;font-size:15px;font-weight:600;line-height:1.3;">{{ key_metric_value }}</p>
                  <p style="margin:0;color:#0ea5e9;font-size:11px;font-weight:600;letter-spacing:0.3px;">{{ key_metric_caption }}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>

        {# -------- TODAY'S TELL -------- #}
        <tr>
          <td style="padding:32px 28px 8px 28px;">
            <p style="margin:0 0 18px 0;color:#0f172a;font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;border-bottom:2px solid #0ea5e9;padding-bottom:8px;display:inline-block;">
              Today's Tell
            </p>

            {% if tells and tells|length > 0 %}
              {% for tell in tells %}
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#ffffff;border:1px solid #e2e8f0;border-left:4px solid {{ tell.accent_color }};border-radius:8px;margin-bottom:16px;">
                <tr>
                  <td style="padding:24px 24px 8px 24px;">
                    <p style="margin:0;color:#0f172a;font-size:18px;font-weight:700;letter-spacing:0.3px;line-height:1.2;">{{ tell.ticker }}</p>
                    <p style="margin:4px 0 0 0;color:#64748b;font-size:11px;letter-spacing:0.3px;">{{ tell.sub_header }}</p>
                  </td>
                </tr>
                <tr>
                  <td style="padding:8px 24px 24px 24px;">
                    <p style="margin:0;color:#334155;font-size:13px;line-height:1.7;">
                      {{ tell.observation|safe }}
                    </p>
                  </td>
                </tr>
              </table>
              {% endfor %}
            {% else %}
              {# Quiet Tape panel — no name scored >=80 #}
              <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#fffbeb;border:1px solid #fcd34d;border-radius:10px;">
                <tr>
                  <td style="padding:32px 28px;text-align:center;">
                    <p style="margin:0 0 12px 0;color:#92400e;font-size:11px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;">Quiet Tape</p>
                    <p style="margin:0 0 18px 0;color:#78350f;font-size:18px;line-height:1.5;font-weight:700;">No standout single-name positioning today.</p>
                    <p style="margin:0;color:#92400e;font-size:13px;line-height:1.65;">
                      Flow distributed evenly across index products. No single ticker accumulated the kind of one-sided ask-side imbalance or concentrated dark-pool absorption that draws institutional attention. Tape stayed in observation mode.
                    </p>
                  </td>
                </tr>
              </table>
              <p style="margin:18px 0 0 0;color:#64748b;font-size:11px;line-height:1.6;font-style:italic;text-align:center;">
                Some sessions reveal positioning. This one didn't.
              </p>
            {% endif %}
          </td>
        </tr>

        {# -------- What Changed -------- #}
        <tr>
          <td style="padding:32px 28px 8px 28px;">
            <p style="margin:0 0 18px 0;color:#0f172a;font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;border-bottom:2px solid #0ea5e9;padding-bottom:8px;display:inline-block;">
              What Changed
            </p>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
              {% for change in changes %}
              <tr>
                <td style="padding:14px 0;{% if not loop.last %}border-bottom:1px solid #f1f5f9;{% endif %}">
                  <p style="margin:0;color:#334155;font-size:13px;line-height:1.65;">
                    <span style="display:inline-block;width:20px;color:{{ change.arrow_color }};font-weight:700;">{{ change.arrow }}</span>
                    {{ change.text|safe }}
                  </p>
                </td>
              </tr>
              {% endfor %}
            </table>
          </td>
        </tr>

        {# -------- Tomorrow's Catalyst -------- #}
        {% if catalysts and catalysts|length > 0 %}
        <tr>
          <td style="padding:32px 28px 8px 28px;">
            <p style="margin:0 0 18px 0;color:#0f172a;font-size:11px;font-weight:700;letter-spacing:1.8px;text-transform:uppercase;border-bottom:2px solid #fb7185;padding-bottom:8px;display:inline-block;">
              Tomorrow's Catalyst
            </p>
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background:#fef2f2;border-left:3px solid #fb7185;border-radius:6px;">
              <tr>
                <td style="padding:20px 22px;">
                  {% for catalyst in catalysts %}
                  <p style="margin:0{% if not loop.last %} 0 14px 0{% endif %};color:#7f1d1d;font-size:13px;line-height:1.65;">
                    {{ catalyst.text|safe }}
                  </p>
                  {% endfor %}
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {% endif %}

        {# -------- Appendix link -------- #}
        <tr>
          <td style="padding:32px 28px 36px 28px;text-align:center;">
            <a href="{{ appendix_url }}" style="display:inline-block;background:#0ea5e9;color:#ffffff;text-decoration:none;padding:14px 32px;border-radius:8px;font-size:13px;font-weight:600;letter-spacing:0.3px;">
              View full data appendix &rarr;
            </a>
            <p style="margin:14px 0 0 0;color:#64748b;font-size:11px;line-height:1.6;">
              Sector heatmap &middot; Top-15 flow &middot; Dark pool &middot; By-the-numbers &middot; Observations
            </p>
          </td>
        </tr>

        {# -------- Footer -------- #}
        <tr>
          <td style="background:#0f172a;padding:28px 28px;text-align:center;">
            <p style="margin:0 0 6px 0;color:#ffffff;font-size:14px;font-weight:600;letter-spacing:0.2px;">AZTMM Research</p>
            <p style="margin:0 0 20px 0;color:#94a3b8;font-size:11px;line-height:1.6;">
              Closing-bell research on options flow + regime
            </p>
            <p style="margin:0 0 10px 0;color:#64748b;font-size:10px;line-height:1.65;">
              Not investment advice. Past patterns do not predict future moves.
            </p>
            <p style="margin:0;color:#64748b;font-size:10px;line-height:1.65;">
              <a href="https://aztmm.com/manage-preferences/" style="color:#0ea5e9;text-decoration:none;">Manage preferences</a> &middot;
              <a href="mailto:nikhilkothari@aztmm.com" style="color:#0ea5e9;text-decoration:none;">nikhilkothari@aztmm.com</a> &middot;
              <a href="https://aztmm.com/" style="color:#0ea5e9;text-decoration:none;">aztmm.com</a>
            </p>
          </td>
        </tr>

      </table>
    </td>
  </tr>
</table>

</div>
{# Data-quality footnote (rendered outside email card) #}
{% if data_quality and data_quality.degraded %}
<p style="max-width:600px;margin:18px auto;color:#64748b;font-size:11px;line-height:1.6;font-style:italic;text-align:center;">
  Data quality note: one or more upstream feeds were degraded for this session
  ({{ data_quality.endpoints_failed }} endpoint{{ 's' if data_quality.endpoints_failed != 1 else '' }} unavailable). Read with appropriate caution.
</p>
{% endif %}
