{# ============================================================
   AZTMM Congress Watch - Dashboard Template

   Renders the body fragment for the WordPress page at
   /congress-watch/. The page loads public.json once on visit
   and the template surfaces that snapshot as a static read.

   Voice rules: observation only. No advisory verbs.
   The publisher's brand-policy scrub MUST pass on render.
   ============================================================ #}

<div class="aztmm-congress-watch" data-as-of="{{ as_of_date }}">

  <header class="cw-hero">
    <div class="cw-meta">
      <span class="cw-stamp">As of {{ as_of }}</span>
      <span class="cw-sep">·</span>
      <span class="cw-cadence">End-of-session snapshot</span>
    </div>
    <h2 class="cw-title">Congress Watch</h2>
    <p class="cw-sub">Tonight's congressional trade disclosures, surfaced as observations.</p>
  </header>

  {# -------- 30-DAY TREND SPARKLINE -------- #}
  <section class="sparkline-section cw-section">
    <h3>30-day trend - {{ headline_metric_label }}</h3>
    {% if sparkline_available %}
    <svg class="sparkline" viewBox="0 0 600 80" preserveAspectRatio="none" aria-label="30-day trend sparkline" role="img">
      <line x1="0" y1="79" x2="600" y2="79" stroke="#94a3b8" stroke-width="0.5" />
      <line x1="0" y1="1"  x2="600" y2="1"  stroke="#94a3b8" stroke-width="0.5" />
      <polyline fill="none" stroke="#38bdf8" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" points="{{ sparkline_polyline }}" />
    </svg>
    <p class="sparkline-caption">{{ sparkline_first_date }} to {{ sparkline_last_date }}. Latest: {{ sparkline_latest_value }}.</p>
    {% else %}
    <p class="sparkline-caption">{{ sparkline_placeholder }}</p>
    {% endif %}
  </section>

  {# -------- COMMENTARY -------- #}
  <section class="cw-section cw-commentary">
    <h3>Tonight's notes</h3>
    {% if commentary %}
    <ul class="cw-notes">
      {% for line in commentary %}
        <li>{{ line }}</li>
      {% endfor %}
    </ul>
    {% else %}
    <p>Quiet evening - nothing of journal note in tonight's window.</p>
    {% endif %}
  </section>

  {# -------- TONIGHT'S NUMBERS -------- #}
  <section class="cw-section cw-summary">
    <h3>Tonight's numbers</h3>
    <ul class="cw-stats">
      <li><strong>{{ summary.filings_today }}</strong> filings filed today</li>
      <li><strong>{{ summary.members_today }}</strong> distinct members reporting</li>
      <li><strong>{{ summary.tickers_today }}</strong> distinct tickers disclosed</li>
      <li><strong>{{ summary.large_filings_today }}</strong> in the larger disclosure tiers</li>
      <li><strong>{{ summary.late_filings_today }}</strong> filings arriving outside the usual window</li>
    </ul>

    {% if summary.chamber_breakdown %}
    <p class="cw-chambers">
      Chamber mix:
      {% for k, v in summary.chamber_breakdown.items() %}
        <span class="cw-chamber cw-chamber-{{ k }}">{{ k }}: {{ v }}</span>{% if not loop.last %}, {% endif %}
      {% endfor %}
    </p>
    {% endif %}
  </section>

  {# -------- NOTABLE TICKER CLUSTERS -------- #}
  {% if notable.ticker_clusters %}
  <section class="cw-section cw-clusters">
    <h3>Tickers with multi-member disclosures this week</h3>
    <table class="cw-table">
      <thead>
        <tr><th>Ticker</th><th>Sector</th><th>Members</th><th>Filings</th><th>Window</th><th>Tilt</th></tr>
      </thead>
      <tbody>
      {% for c in notable.ticker_clusters %}
        <tr>
          <td><strong>{{ c.ticker }}</strong></td>
          <td>{{ c.sector }}</td>
          <td>{{ c.member_count }}</td>
          <td>{{ c.filings_in_window }}</td>
          <td>{{ c.window_start }} to {{ c.window_end }}</td>
          <td>{{ c.tilt }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    <p class="cw-note">
      A cluster reflects how many distinct members disclosed activity in the same ticker
      inside a short window. It is a noticing tool, not a directive.
    </p>
  </section>
  {% endif %}

  {# -------- SECTOR CLUSTERS -------- #}
  {% if notable.sector_clusters %}
  <section class="cw-section cw-sector-clusters">
    <h3>Sector-level clusters this week</h3>
    <ul class="cw-sector-list">
    {% for s in notable.sector_clusters %}
      <li>{{ s.member_count }} members disclosed trades in <strong>{{ s.sector }}</strong>
          inside the {{ s.window_start }} to {{ s.window_end }} window
          ({{ s.filings_in_window }} filings total).</li>
    {% endfor %}
    </ul>
  </section>
  {% endif %}

  {# -------- LARGER FILINGS TODAY -------- #}
  {% if notable.large_filings %}
  <section class="cw-section cw-large">
    <h3>Larger disclosure tiers - today's filings</h3>
    <table class="cw-table">
      <thead>
        <tr><th>Reporter</th><th>Chamber</th><th>Ticker</th><th>Sector</th><th>Type</th><th>Range</th><th>Ownership</th></tr>
      </thead>
      <tbody>
      {% for t in notable.large_filings %}
        <tr>
          <td>{{ t.name }}</td>
          <td>{{ t.chamber }}</td>
          <td>{{ t.ticker or '-' }}</td>
          <td>{{ t.sector }}</td>
          <td>{{ t.direction }}</td>
          <td>{{ t.amount_band }}</td>
          <td>{{ t.ownership }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# -------- LATE FILINGS -------- #}
  {% if notable.late_filings %}
  <section class="cw-section cw-late">
    <h3>Filings arriving outside the usual window</h3>
    <p class="cw-note">
      The transaction date and the filing date are usually within 30-45 days.
      The list below is filings where that gap is wider - a timing color cue,
      not a directional read.
    </p>
    <table class="cw-table">
      <thead>
        <tr><th>Reporter</th><th>Chamber</th><th>Ticker</th><th>Type</th><th>Range</th><th>Gap (days)</th></tr>
      </thead>
      <tbody>
      {% for t in notable.late_filings %}
        <tr>
          <td>{{ t.name }}</td>
          <td>{{ t.chamber }}</td>
          <td>{{ t.ticker or '-' }}</td>
          <td>{{ t.direction }}</td>
          <td>{{ t.amount_band }}</td>
          <td>{{ t.filing_lag_days }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# -------- MOST ACTIVE TODAY -------- #}
  {% if most_active_today %}
  <section class="cw-section cw-active">
    <h3>Most-active reporters today</h3>
    <ol class="cw-active-list">
    {% for m in most_active_today %}
      <li><strong>{{ m.name }}</strong> - {{ m.filings }} filings</li>
    {% endfor %}
    </ol>
  </section>
  {% endif %}

  {# -------- ALL OF TONIGHT'S FILINGS (short table) -------- #}
  {% if trades_today %}
  <section class="cw-section cw-all">
    <h3>All filings dated tonight</h3>
    <table class="cw-table cw-table-all">
      <thead>
        <tr><th>Reporter</th><th>Chamber</th><th>Ticker</th><th>Sector</th><th>Type</th><th>Range</th><th>Ownership</th><th>Transaction date</th></tr>
      </thead>
      <tbody>
      {% for t in trades_today %}
        <tr>
          <td>{{ t.name }}</td>
          <td>{{ t.chamber }}</td>
          <td>{{ t.ticker or '-' }}</td>
          <td>{{ t.sector }}</td>
          <td>{{ t.direction }}</td>
          <td>{{ t.amount_band }}</td>
          <td>{{ t.ownership }}</td>
          <td>{{ t.transaction_date or '-' }}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# -------- FOOTER / DISCLAIMER -------- #}
  <footer class="cw-footer">
    <p class="cw-disclaimer">
      Personal observations of one trader. Not investment advice. Data refreshed once daily at 5:00 PM ET.
    </p>
    {% if data_quality.degraded %}
    <p class="cw-degraded">
      <em>Data note: one or more upstream feeds were degraded for this session
      ({{ data_quality.endpoints_failed }} endpoint{{ 's' if data_quality.endpoints_failed != 1 else '' }} unavailable).
      Read with appropriate caution.</em>
    </p>
    {% endif %}
    <p class="cw-generated"><small>Snapshot generated at {{ generated_at }}.</small></p>
  </footer>

</div>
